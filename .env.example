# Shuru Korun environment variables
# Copy to .env.local for local development. Never commit .env* files.

# AI providers (server-only). Leave unset to run in mock mode (MOCK_AI=1).
GROQ_API_KEY=
GEMINI_API_KEY=

# Model names (set per deploy day; free-tier names change).
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.0-flash

# Per-visitor rate limit (requests per minute).
RATE_LIMIT_PER_MINUTE=12

# Set to 1 to force the deterministic mock provider (no keys needed).
MOCK_AI=1
